class PermissionRequestSerializer(serializers.ModelSerializer):
    employee_name = serializers.CharField(
        source='employee.full_name',
        read_only=True
    )
    employee_id = serializers.CharField(
        source='employee.employee_id',
        read_only=True
    )
    approved_by_name = serializers.SerializerMethodField()

    class Meta:
        model = PermissionRequest
        fields = '__all__'
        read_only_fields = [
            'employee',
            'status',
            'approved_by',
            'approved_at',
            'rejection_reason',
            'created_at',
            'updated_at',
        ]

    def get_approved_by_name(self, obj):
        if obj.approved_by:
            return obj.approved_by.get_full_name() or obj.approved_by.username
        return None

    def validate_duration_minutes(self, value):
        if value not in [30, 60]:
            raise serializers.ValidationError(
                "Permission duration must be 30 or 60 minutes."
            )
        return value

    def validate(self, attrs):
        request = self.context.get('request')

        if not request or not hasattr(request.user, 'employee_profile'):
            return attrs

        from django.db.models import Sum

        employee = request.user.employee_profile
        date = attrs.get('date')
        duration = attrs.get('duration_minutes', 0)

        if not date:
            raise serializers.ValidationError({
                'date': 'Permission date is required.'
            })

        daily_minutes = PermissionRequest.objects.filter(
            employee=employee,
            date=date,
            status__in=['PENDING', 'APPROVED']
        ).aggregate(total=Sum('duration_minutes'))['total'] or 0

        if daily_minutes + duration > 60:
            raise serializers.ValidationError({
                'duration_minutes':
                    f'Daily permission limit is 60 minutes. '
                    f'Already requested/approved: {daily_minutes} minutes.'
            })

        from attendance.services import get_attendance_cycle

        cycle_start, cycle_end = get_attendance_cycle(
            date.year,
            date.month
        )

        cycle_minutes = PermissionRequest.objects.filter(
            employee=employee,
            date__gte=cycle_start,
            date__lte=cycle_end,
            status__in=['PENDING', 'APPROVED']
        ).aggregate(total=Sum('duration_minutes'))['total'] or 0

        if cycle_minutes + duration > 180:
            raise serializers.ValidationError({
                'duration_minutes':
                    f'Permission limit for this attendance cycle is 180 minutes. '
                    f'Already requested/approved: {cycle_minutes} minutes.'
            })

        return attrs


class LeaveRequestSerializer(serializers.ModelSerializer):
    employee_name = serializers.CharField(
        source='employee.full_name',
        read_only=True
    )
    employee_id = serializers.CharField(
        source='employee.employee_id',
        read_only=True
    )
    approved_by_name = serializers.SerializerMethodField()

    class Meta:
        model = LeaveRequest
        fields = '__all__'
        read_only_fields = [
            'employee',
            'status',
            'approved_by',
            'approved_at',
            'rejection_reason',
            'created_at',
            'updated_at',
        ]

    def get_approved_by_name(self, obj):
        if obj.approved_by:
            return obj.approved_by.get_full_name() or obj.approved_by.username
        return None

    def validate(self, attrs):
        start_date = attrs.get('start_date')
        end_date = attrs.get('end_date')

        if start_date and end_date and end_date < start_date:
            raise serializers.ValidationError({
                'end_date': 'End date cannot be before start date.'
            })

        request = self.context.get('request')

        if request and hasattr(request.user, 'employee_profile'):
            employee = request.user.employee_profile

            overlapping = LeaveRequest.objects.filter(
                employee=employee,
                status__in=['PENDING', 'APPROVED'],
                start_date__lte=end_date,
                end_date__gte=start_date,
            )

            if self.instance:
                overlapping = overlapping.exclude(pk=self.instance.pk)

            if overlapping.exists():
                raise serializers.ValidationError({
                    'date':
                        'You already have a pending or approved leave '
                        'for one or more selected dates.'
                })

        return attrs
