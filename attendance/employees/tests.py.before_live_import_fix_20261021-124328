class LocationSharingStopDurationTests(TestCase):
    def setUp(self):
        User = get_user_model()
        self.user = User.objects.create_user(
            username="stop_test_user",
            password="test-password-only",
            role="EMPLOYEE",
        )
        company = Company.objects.create(name="Test Company")
        branch = Branch.objects.create(
            company=company,
            branch_name="Test Branch",
            office_address="Test address",
            latitude=11.0,
            longitude=76.0,
        )
        self.employee = Employee.objects.create(
            user=self.user,
            employee_id="STOP-TEST-001",
            full_name="Test Employee",
            branch=branch,
            department="Testing",
            designation="Field Employee",
            work_type="FIELD",
            employment_status="ACTIVE",
            status=True,
        )

        self.off_time = timezone.now()
        self.session_start = self.off_time - timedelta(minutes=20)
        self.sharing = EmployeeLocationSharing.objects.create(
            employee=self.employee,
            is_enabled=True,
            enabled_at=self.session_start,
        )
        self.factory = APIRequestFactory()

    @patch("employees.tracking_views.timezone.now")
    def test_off_closes_stop_and_creates_location_off(self, mock_now):
        mock_now.return_value = self.off_time
        stop_start = self.off_time - timedelta(minutes=7, seconds=30)

        stop = EmployeeLocationTrackingEvent.objects.create(
            employee=self.employee,
            event_type="STOP",
            recorded_at=stop_start,
            details={"stop_started_at": stop_start.isoformat()},
        )
        EmployeeLocation.objects.create(
            employee=self.employee,
            latitude="11.000000",
            longitude="76.000000",
            recorded_at=self.off_time - timedelta(seconds=10),
        )

        request = self.factory.post(
            "/api/tracking/sharing/",
            {"enabled": False},
            format="json",
        )
        force_authenticate(request, user=self.user)
        response = LocationSharingView.as_view()(request)

        self.assertEqual(response.status_code, 200)
        stop.refresh_from_db()
        self.sharing.refresh_from_db()

        self.assertFalse(self.sharing.is_enabled)
        self.assertEqual(self.sharing.disabled_at, self.off_time)
        self.assertEqual(stop.details["stop_duration_seconds"], 450.0)
        self.assertEqual(stop.details["stop_duration_minutes"], 7.5)
        self.assertEqual(
            stop.details["duration_method"],
            "sharing_disabled_estimate",
        )
        self.assertIn("stop_ended_at", stop.details)
        self.assertTrue(
            EmployeeLocationTrackingEvent.objects.filter(
                employee=self.employee,
                event_type="LOCATION_OFF",
                details={"source": "sharing_api"},
            ).exists()
        )

    @patch("employees.tracking_views.timezone.now")
    def test_off_without_stop_still_creates_location_off(self, mock_now):
        mock_now.return_value = self.off_time
        EmployeeLocationTrackingEvent.objects.create(
            employee=self.employee,
            event_type="DRIVE",
            recorded_at=self.off_time - timedelta(minutes=2),
        )

        request = self.factory.post(
            "/api/tracking/sharing/",
            {"enabled": False},
            format="json",
        )
        force_authenticate(request, user=self.user)
        response = LocationSharingView.as_view()(request)

        self.assertEqual(response.status_code, 200)
        self.sharing.refresh_from_db()
        self.assertFalse(self.sharing.is_enabled)
        self.assertTrue(
            EmployeeLocationTrackingEvent.objects.filter(
                employee=self.employee,
                event_type="LOCATION_OFF",
                details={"source": "sharing_api"},
            ).exists()
        )


class LocationUpdateMovementTests(TestCase):
    def setUp(self):
        User = get_user_model()
        self.user = User.objects.create_user(
            username="movement_test_user",
            password="test-password-only",
            role="EMPLOYEE",
        )
        company = Company.objects.create(name="Movement Test Company")
        branch = Branch.objects.create(
            company=company,
            branch_name="Movement Test Branch",
            office_address="Test address",
            latitude=11.0,
            longitude=76.0,
        )
        self.employee = Employee.objects.create(
            user=self.user,
            employee_id="MOVE-TEST-001",
            full_name="Movement Test Employee",
            branch=branch,
            department="Testing",
            designation="Field Employee",
            work_type="FIELD",
            employment_status="ACTIVE",
            status=True,
        )
        now = timezone.now()
        self.sharing = EmployeeLocationSharing.objects.create(
            employee=self.employee,
            is_enabled=True,
            enabled_at=now - timedelta(minutes=10),
        )
        self.factory = APIRequestFactory()

    @patch("employees.tracking_views.reverse_geocode", return_value="Test place")
    def test_gps_movement_creates_drive_event(self, mock_geocode):
        previous_time = timezone.now() - timedelta(seconds=30)
        EmployeeLocation.objects.create(
            employee=self.employee,
            latitude="11.000000",
            longitude="76.000000",
            accuracy_meters=10,
            recorded_at=previous_time,
        )

        request = self.factory.post(
            "/api/tracking/update/",
            {
                "latitude": "11.000000",
                "longitude": "76.001200",
                "accuracy_meters": 10,
            },
            format="json",
        )
        force_authenticate(request, user=self.user)
        response = LocationUpdateView.as_view()(request)

        self.assertEqual(response.status_code, 201)
        drive = EmployeeLocationTrackingEvent.objects.filter(
            employee=self.employee,
            event_type="DRIVE",
        ).first()
        self.assertIsNotNone(drive)
        self.assertEqual(drive.details["source"], "gps_estimate")

    @patch("employees.tracking_views.reverse_geocode", return_value="Test place")
    def test_stationary_gps_points_create_stop_event(self, mock_geocode):
        previous_time = timezone.now() - timedelta(seconds=120)
        EmployeeLocation.objects.create(
            employee=self.employee,
            latitude="11.000000",
            longitude="76.000000",
            accuracy_meters=10,
            recorded_at=previous_time,
        )

        request = self.factory.post(
            "/api/tracking/update/",
            {
                "latitude": "11.000000",
                "longitude": "76.000000",
                "accuracy_meters": 10,
            },
            format="json",
        )
        force_authenticate(request, user=self.user)
        response = LocationUpdateView.as_view()(request)

        self.assertEqual(response.status_code, 201)
        stop = EmployeeLocationTrackingEvent.objects.filter(
            employee=self.employee,
            event_type="STOP",
        ).first()
        self.assertIsNotNone(stop)
        self.assertGreaterEqual(stop.details["stop_duration_seconds"], 60)
        self.assertEqual(stop.details["duration_method"], "gps_estimate")


    def _post_location_update(self, data):
        request = self.factory.post(
            "/api/tracking/update/",
            data,
            format="json",
        )
        force_authenticate(request, user=self.user)
        return LocationUpdateView.as_view()(request)

    def test_missing_coordinates_return_400(self):
        response = self._post_location_update({
            "accuracy_meters": 10,
        })
        self.assertEqual(response.status_code, 400)
        self.assertEqual(
            response.data["detail"],
            "Valid latitude and longitude are required.",
        )

    def test_invalid_latitude_returns_400(self):
        response = self._post_location_update({
            "latitude": "91",
            "longitude": "76",
            "accuracy_meters": 10,
        })
        self.assertEqual(response.status_code, 400)
        self.assertEqual(
            response.data["detail"],
            "Latitude must be between -90 and 90.",
        )

    def test_invalid_longitude_returns_400(self):
        response = self._post_location_update({
            "latitude": "11",
            "longitude": "181",
            "accuracy_meters": 10,
        })
        self.assertEqual(response.status_code, 400)
        self.assertEqual(
            response.data["detail"],
            "Longitude must be between -180 and 180.",
        )

    def test_invalid_accuracy_returns_400(self):
        response = self._post_location_update({
            "latitude": "11",
            "longitude": "76",
            "accuracy_meters": -1,
        })
        self.assertEqual(response.status_code, 400)
        self.assertEqual(
            response.data["detail"],
            "accuracy_meters must be between 0 and 10000.",
        )

    @patch("employees.tracking_views.reverse_geocode")
    def test_poor_accuracy_skips_reverse_geocoding(self, mock_geocode):
        response = self._post_location_update({
            "latitude": "11",
            "longitude": "76",
            "accuracy_meters": 150,
        })
        self.assertEqual(response.status_code, 201)
        mock_geocode.assert_not_called()

        location = EmployeeLocation.objects.filter(
            employee=self.employee,
        ).latest("recorded_at")
        self.assertEqual(location.accuracy_meters, 150)
        self.assertEqual(location.location_name, "")


