class LocationSessionAndHistoryTests(TestCase):
    def setUp(self):
        User = get_user_model()
        self.user = User.objects.create_user(
            username="history_test_user",
            password="test-password-only",
            role="SUPER_ADMIN",
        )
        company = Company.objects.create(name="History Test Company")
        branch = Branch.objects.create(
            company=company,
            branch_name="History Test Branch",
            office_address="Test address",
            latitude=11.0,
            longitude=76.0,
        )
        self.employee = Employee.objects.create(
            user=self.user,
            employee_id="HISTORY-TEST-001",
            full_name="History Test Employee",
            branch=branch,
            department="Testing",
            designation="Field Employee",
            work_type="FIELD",
            employment_status="ACTIVE",
            status=True,
        )
        self.factory = APIRequestFactory()

    @patch("employees.tracking_views.reverse_geocode", return_value="New session place")
    def test_new_session_does_not_compare_old_session_gps(self, mock_geocode):
        now = timezone.now()
        EmployeeLocation.objects.create(
            employee=self.employee,
            latitude="11.000000",
            longitude="76.000000",
            accuracy_meters=10,
            recorded_at=now - timedelta(minutes=5),
        )
        EmployeeLocationSharing.objects.create(
            employee=self.employee,
            is_enabled=True,
            enabled_at=now - timedelta(seconds=20),
        )

        request = self.factory.post(
            "/api/tracking/update/",
            {
                "latitude": "11.001200",
                "longitude": "76.000000",
                "accuracy_meters": 10,
            },
            format="json",
        )
        force_authenticate(request, user=self.user)
        response = LocationUpdateView.as_view()(request)

        self.assertEqual(response.status_code, 201)
        self.assertFalse(
            EmployeeLocationTrackingEvent.objects.filter(
                employee=self.employee,
                event_type__in=["DRIVE", "STOP"],
            ).exists()
        )

    def test_history_returns_location_name_and_stop_duration(self):
        location = EmployeeLocation.objects.create(
            employee=self.employee,
            latitude="11.000000",
            longitude="76.000000",
            accuracy_meters=10,
            location_name="Test Street, Coimbatore",
        )
        stop = EmployeeLocationTrackingEvent.objects.create(
            employee=self.employee,
            event_type="STOP",
            latitude="11.000000",
            longitude="76.000000",
            location_name="Test Street, Coimbatore",
            details={
                "stop_started_at": (timezone.now() - timedelta(minutes=5)).isoformat(),
                "stop_duration_seconds": 300.0,
                "stop_duration_minutes": 5.0,
                "duration_method": "gps_estimate",
            },
        )

        request = self.factory.get(
            f"/api/tracking/history/{self.employee.pk}/"
        )
        force_authenticate(request, user=self.user)
        response = LocationHistoryView.as_view()(request, employee_id=self.employee.pk)

        self.assertEqual(response.status_code, 200)
        results = response.data.get("results", response.data)
        if isinstance(results, dict):
            results = results.get("results", results.get("timeline", []))
        gps_item = next(item for item in results if item.get("type") == "GPS")
        stop_item = next(
            item for item in results
            if item.get("type") == "EVENT" and item.get("id") == f"event-{stop.pk}"
        )
        self.assertEqual(gps_item["location_name"], "Test Street, Coimbatore")
        self.assertEqual(stop_item["location_name"], "Test Street, Coimbatore")
        self.assertEqual(stop_item["details"]["stop_duration_seconds"], 300.0)
        self.assertEqual(stop_item["details"]["stop_duration_minutes"], 5.0)

    def test_history_estimates_duration_for_legacy_stop_event(self):
        stop = EmployeeLocationTrackingEvent.objects.create(
            employee=self.employee,
            event_type="STOP",
            details={
                "elapsed_seconds": 674.5,
                "source": "gps_estimate",
            },
        )

        request = self.factory.get(
            f"/api/tracking/history/{self.employee.pk}/"
        )
        force_authenticate(request, user=self.user)
        response = LocationHistoryView.as_view()(request, employee_id=self.employee.pk)

        self.assertEqual(response.status_code, 200)
        results = response.data.get("results", response.data)
        if isinstance(results, dict):
            results = results.get("results", results.get("timeline", []))
        stop_item = next(
            item for item in results
            if item.get("type") == "EVENT" and item.get("id") == f"event-{stop.pk}"
        )
        self.assertEqual(stop_item["details"]["stop_duration_seconds"], 674.5)
        self.assertEqual(stop_item["details"]["stop_duration_minutes"], 11.2)
        self.assertEqual(
            stop_item["details"]["duration_method"],
            "observed_gps_interval_estimate",
        )
